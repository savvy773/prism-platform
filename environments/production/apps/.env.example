# Copy to environments/production/apps/.env on the Ubuntu server only.
# Metadata only until Compose definitions and lifecycle scripts are implemented.
PRISM_ENV=production
COMPOSE_PROJECT_NAME=prism-prod-apps
PRISM_MARIADB_NETWORK=prism-prod-mariadb-data
# Optional: attach only applications that actually use PostgreSQL.
PRISM_POSTGRES_NETWORK=prism-prod-postgres-data
TZ=Asia/Seoul
