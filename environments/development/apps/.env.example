# Copy to environments/development/apps/.env. Never commit the populated file.
# Metadata only until Compose definitions and lifecycle scripts are implemented.
PRISM_ENV=development
COMPOSE_PROJECT_NAME=prism-dev-apps
PRISM_MARIADB_NETWORK=prism-dev-mariadb-data
# Optional: attach only applications that actually use PostgreSQL.
PRISM_POSTGRES_NETWORK=prism-dev-postgres-data
TZ=Asia/Seoul
